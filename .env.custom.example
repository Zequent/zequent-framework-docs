# ==================== ZEQUENT FRAMEWORK - ENVIRONMENT CONFIGURATION ====================
# Copy this file to .env.custom and adjust values for your deployment.
# This file provides a complete overview of all configurable environment variables.
# ========================================================================================

# ==================== DEPLOYMENT PROFILE ====================
# Profile: dev (local), docker (compose), k8s (kubernetes)
QUARKUS_PROFILE=docker

# ==================== INFRASTRUCTURE ====================
# Redis Configuration
REDIS_URL=redis://redis:6379

# Database Configuration (Connector Service only)
DATABASE_URL=jdbc:postgresql://zequent_db:5432/zequent_db
DATABASE_REACTIVE_URL=postgresql://zequent_db:5432/zequent_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ==================== SERVICE DISCOVERY (gRPC) ====================
# Configure service hostnames and ports for inter-service communication.
# Supports custom container/service names for multi-tenant or namespace-specific deployments.

# Connector Service (Port: 8010) - Core asset & vendor management
CONNECTOR_SERVICE_HOST=connector-service
CONNECTOR_SERVICE_PORT=8010

# Live Data Service (Port: 8003) - Real-time telemetry streaming
LIVE_DATA_SERVICE_HOST=live-data-service
LIVE_DATA_SERVICE_PORT=8003

# Remote Control Service (Port: 8002) - Asset command execution
REMOTE_CONTROL_SERVICE_HOST=remote-control-service
REMOTE_CONTROL_SERVICE_PORT=8002

# Mission Autonomy Service (Port: 8004) - Mission planning & execution
MISSION_AUTONOMY_SERVICE_HOST=mission-autonomy-service
MISSION_AUTONOMY_SERVICE_PORT=8004

# ==================== GRPC CLIENT-SIDE LOAD BALANCING ====================
# Enables automatic load balancing across scaled service instances.
# Example: docker-compose up --scale connector-service=3
# Uses DNS-based service discovery with round-robin distribution.

# Load balancing policy: round_robin (default) or pick_first
GRPC_LOAD_BALANCING_POLICY=round_robin

# Enable DNS resolver for service discovery (required for load balancing)
GRPC_ENABLE_DNS_RESOLVER=true

# ==================== OBSERVABILITY ====================
# OpenTelemetry (Distributed Tracing, Metrics, Logs)
# Enable for production monitoring with Jaeger/Prometheus/Grafana stack

# Distributed Tracing - View request flows across services in Jaeger UI
# Set to true to trace gRPC calls, HTTP requests, and database queries
OTEL_TRACES_ENABLED=true

# Metrics Export - Collect performance metrics for analysis
# Set to true to export metrics to Jaeger or compatible OTLP collector
OTEL_METRICS_ENABLED=true

# Structured Logging - Forward logs to centralized logging system
# Set to true to export logs via OTLP to Jaeger or log aggregator
OTEL_LOGS_ENABLED=true

# OpenTelemetry Collector Endpoint
# Default: Jaeger all-in-one container (OTLP gRPC receiver on port 4317)
OTEL_ENDPOINT=http://jaeger-all-in-one:4317

# Micrometer Metrics (Alternative/Additional metrics framework)
# Enable for JVM, HTTP, and gRPC metrics collection
MICROMETER_ENABLED=true

# Prometheus Metrics Export
# Set to true to expose /q/metrics endpoint for Prometheus scraping
PROMETHEUS_ENABLED=true

# Prometheus Metrics Path (optional, default: /q/metrics)
PROMETHEUS_PATH=/q/metrics

# Detailed Metrics Binders (optional, defaults to true when Micrometer is enabled)
MICROMETER_BINDER_JVM=true
MICROMETER_BINDER_SYSTEM=true
HTTP_SERVER_ENABLED=true
GRPC_SERVER_ENABLED=true
GRPC_CLIENT_ENABLED=true

# ==================== CONTAINER PORTS (Optional Override) ====================
# Override default container ports if needed (e.g., avoiding conflicts)
# CONNECTOR_PORT=8010
# LIVE_DATA_PORT=8003
# REMOTE_CONTROL_PORT=8002
# MISSION_AUTONOMY_PORT=8004

# ==================== EXAMPLE CONFIGURATIONS ====================

# --- Production (Full Observability) ---
# OTEL_TRACES_ENABLED=true
# OTEL_METRICS_ENABLED=true
# OTEL_LOGS_ENABLED=true
# MICROMETER_ENABLED=true
# PROMETHEUS_ENABLED=true
# OTEL_ENDPOINT=http://jaeger-collector:4317

# --- Development (Minimal Overhead) ---
# OTEL_TRACES_ENABLED=false
# OTEL_METRICS_ENABLED=false
# OTEL_LOGS_ENABLED=false
# MICROMETER_ENABLED=false
# PROMETHEUS_ENABLED=false

# --- Kubernetes with Custom Namespace ---
# QUARKUS_PROFILE=k8s
# CONNECTOR_SERVICE_HOST=connector-service.zequent-prod.svc.cluster.local
# LIVE_DATA_SERVICE_HOST=live-data-service.zequent-prod.svc.cluster.local
# REDIS_URL=redis://redis.zequent-prod.svc.cluster.local:6379

# ==================== NOTES ====================
# 1. For local development (QUARKUS_PROFILE=dev), most variables are ignored.
#    Services use localhost defaults defined in application.properties.
#
# 2. For Docker Compose (QUARKUS_PROFILE=docker), use service names like "redis".
#
# 3. For Kubernetes (QUARKUS_PROFILE=k8s), use full service DNS names if needed:
#    <service-name>.<namespace>.svc.cluster.local
#
# 4. Redis property differs by service:
#    - Most services: REDIS_URL=redis://redis:6379
#    - Ensure consistency across all service configurations.
#
# 5. Load balancing works automatically in Docker Compose and Kubernetes when
#    multiple replicas/pods are running and GRPC_ENABLE_DNS_RESOLVER=true.
